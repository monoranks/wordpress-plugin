{
  "name": "monoranks/wordpress-plugin",
  "description": "MonoRanks for WordPress: SEO, AEO and GEO audits with the fixes you approve written into WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://monoranks.com/product/wordpress/",
  "require": {
    "php": ">=7.4"
  },
  "autoload": {
    "psr-4": {
      "MonoRanks\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "veronalabs/wp-scoper": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "build": "composer install --no-dev --optimize-autoloader --classmap-authoritative"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "phpunit/phpunit": "^9.6",
    "veronalabs/wp-scoper": "^1.4",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload-dev": {
    "psr-4": {
      "MonoRanks\\Tests\\": "tests/unit/"
    }
  },
  "extra": {
    "wp-scoper": {
      "namespace_prefix": "MonoRanks\\Deps",
      "class_prefix": "MonoRanks_",
      "constant_prefix": "MONORANKS_",
      "packages": [],
      "target_directory": "packages",
      "update_call_sites": true
    }
  }
}

{
  "name": "monoranks/wordpress-plugin",
  "description": "MonoRanks for WordPress: SEO, AEO and GEO audits with the fixes you approve written into WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://monoranks.com/product/wordpress/",
  "require": {
    "php": ">=7.4"
  },
  "autoload": {
    "psr-4": {
      "MonoRanks\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "wpify/scoper": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "build": "composer install --no-dev --optimize-autoloader --classmap-authoritative"
  },
  "require-dev": {
    "wpify/scoper": "^4.0",
    "phpunit/phpunit": "^9.6",
    "brain/monkey": "^2.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload-dev": {
    "psr-4": {
      "MonoRanks\\Tests\\": "tests/unit/"
    }
  },
  "extra": {
    "wpify-scoper": {
      "prefix": "MonoRanksDeps",
      "folder": "deps",
      "globals": [
        "wordpress"
      ],
      "composerjson": "composer-deps.json",
      "composerlock": "composer-deps.lock",
      "autorun": true
    }
  }
}

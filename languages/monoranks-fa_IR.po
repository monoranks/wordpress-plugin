#: tmp/i18n/screens/Settings.js:64
msgid "No SEO plugin"
msgstr "بدون افزونهٔ سئو"

#: tmp/i18n/screens/Settings.js:64
msgid "MonoRanks prints the approved title, description, canonical and noindex tags itself"
msgstr "مونورنکس خودش تگ‌های تأییدشدهٔ عنوان، توضیح، کانونیکال و noindex را چاپ می‌کند"

#: tmp/i18n/screens/Settings.js:67
msgid "Send content now"
msgstr "ارسال محتوا"

#: tmp/i18n/screens/Settings.js:68
msgid "Disconnect"
msgstr "قطع اتصال"

#: tmp/i18n/screens/Settings.js:69
msgid "Disconnect stops sending. Fixes already applied stay."
msgstr "قطع اتصال ارسال را متوقف می‌کند. اصلاح‌های اعمال‌شده می‌مانند."

#: tmp/i18n/screens/Settings.js:73
msgid "Use this when your host blocks Application Passwords. In MonoRanks: Settings → API and MCP → New credential with the content:write scope, ticked for this website."
msgstr "وقتی میزبان شما «گذرواژه‌های برنامه» را مسدود کرده از این راه استفاده کنید. در مونورنکس: تنظیمات ← API و MCP ← اعتبارنامهٔ جدید با دسترسی content:write، تیک‌خورده برای این وب‌سایت."

#: tmp/i18n/screens/Settings.js:80
msgid "Use a different key"
msgstr "استفاده از کلید دیگر"

#: tmp/i18n/screens/Settings.js:83
msgid "In MonoRanks: Settings → API and MCP → New credential with the content:write scope, ticked for this website. Paste it here. With a key alone MonoRanks receives your content; to apply fixes, also use Connect to WordPress in MonoRanks."
msgstr "در مونورنکس: تنظیمات ← API و MCP ← اعتبارنامهٔ جدید با دسترسی content:write، تیک‌خورده برای این وب‌سایت. آن را اینجا وارد کنید. با کلید به‌تنهایی مونورنکس محتوای شما را دریافت می‌کند؛ برای اعمال اصلاح‌ها، «اتصال به وردپرس» را هم در مونورنکس انجام دهید."

#: tmp/i18n/screens/Settings.js:91
msgid "What is sent"
msgstr "چه چیزی فرستاده می‌شود"


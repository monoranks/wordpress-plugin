msgstr ""

#. Description of the plugin
#: monoranks.php
msgid "Connects this site to MonoRanks (SEO, AEO and GEO audits): sends published content metadata and applies the fixes you approve there, with undo."
msgstr "این سایت را به مونورنکس (ممیزی SEO، AEO و GEO) متصل می‌کند: فرادادهٔ محتوای منتشرشده را می‌فرستد و اصلاح‌هایی را که آنجا تأیید می‌کنید، با امکان بازگردانی، اعمال می‌کند."

#. Author of the plugin
#: monoranks.php
msgid "VeronaLabs"
msgstr ""

#. Author URI of the plugin

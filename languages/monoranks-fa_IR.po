#: build/i18n/screens/Settings.js:89
msgid "Never sent"
msgstr "هرگز فرستاده نمی‌شود"

#: build/i18n/screens/Settings.js:89
msgid "Drafts, private posts, comments, emails, passwords, plugin or theme settings."
